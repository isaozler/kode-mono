	sub less' dollar by liga.spacer;
} less_dollar_liga;

lookup dollar_greater_liga {
	sub liga.spacer greater' by dollar_greater.liga;
	sub dollar' greater by liga.spacer;
} dollar_greater_liga;

lookup less_asterisk_greater_liga {
	ignore sub less' less' asterisk' greater; #greater_greater_greater escape
	ignore sub less' asterisk' greater' greater; #greater_greater_greater escape
	sub liga.spacer liga.spacer greater' by less_asterisk_greater.liga;
	sub liga.spacer asterisk' greater by liga.spacer;
	sub less' asterisk greater by liga.spacer;
} less_asterisk_greater_liga;

