{
code = "lookup www_liga {
	ignore sub w w' w @LETTER;
	ignore sub w' w w @LETTER;
	sub liga.spacer liga.spacer w' by www.liga;
	sub liga.spacer w' w by liga.spacer;
	sub w' w w by liga.spacer;
} www_liga;

lookup slash_slash_liga {
	ignore sub slash slash' slash;
	ignore sub slash' slash slash;
	sub liga.spacer slash' by slash_slash.liga;
	sub slash' slash by liga.spacer;
} slash_slash_liga;

lookup backslash_backslash_liga {
	ignore sub backslash backslash' backslash;
	ignore sub backslash' backslash backslash;
	sub liga.spacer backslash' by backslash_backslash.liga;
	sub backslash' backslash by liga.spacer;
} backslash_backslash_liga;

lookup asterisk_asterisk_liga {
	ignore sub asterisk asterisk' asterisk;
	ignore sub asterisk' asterisk asterisk;
	sub liga.spacer asterisk' by asterisk_asterisk.liga;
	sub asterisk' asterisk by liga.spacer;
} asterisk_asterisk_liga;

lookup slash_equal_liga {
	ignore sub slash' equal' equal;
	ignore sub @NON_SPACING' slash' equal;
	sub liga.spacer equal' by slash_equal.liga;
	sub slash' equal by liga.spacer;
} slash_equal_liga;

lookup slash_asterisk_liga {
	ignore sub slash' period;
	ignore sub @NON_SPACING' slash' asterisk;
	ignore sub asterisk_asterisk.liga' slash' asterisk;
	sub liga.spacer asterisk' by slash_asterisk.liga;
	sub slash' asterisk by liga.spacer;
} slash_asterisk_liga;

lookup asterisk_slash_liga {
	ignore sub asterisk' asterisk' asterisk;
	ignore sub asterisk slash' @LETTER_OR_NUMBER;
	ignore sub asterisk' slash @LETTER_OR_NUMBER;
	sub liga.spacer slash' by asterisk_slash.liga;
	sub asterisk' slash by liga.spacer;
} asterisk_slash_liga;

lookup colon_colon_liga {
	ignore sub colon colon' colon;
	ignore sub colon' colon colon;
	sub liga.spacer colon' by colon_colon.liga;
	sub colon' colon by liga.spacer;
} colon_colon_liga;

lookup colon_colon_colon_liga {
	ignore sub colon colon colon' colon;
	ignore sub colon colon' colon colon;
	ignore sub colon' colon colon colon;
	sub liga.spacer liga.spacer colon' by colon_colon_colon.liga;
	sub liga.spacer colon' colon by liga.spacer;
	sub colon' colon colon by liga.spacer;
} colon_colon_colon_liga;

lookup plus_plus_liga {
	ignore sub plus plus' plus;
	ignore sub plus' plus plus;
	sub liga.spacer plus' by plus_plus.liga;
	sub plus' plus by liga.spacer;
} plus_plus_liga;

lookup plus_plus_plus_liga {
	ignore sub plus plus plus' plus;
	ignore sub plus plus' plus plus;
	ignore sub plus' plus plus plus;
	sub liga.spacer liga.spacer plus' by plus_plus_plus.liga;
	sub liga.spacer plus' plus by liga.spacer;
	sub plus' plus plus by liga.spacer;
} plus_plus_plus_liga;

lookup equal_equal_liga {
	ignore sub slash equal' equal; #added
	ignore sub less equal' equal; #added
	ignore sub greater equal' equal; #added
	ignore sub exclam equal' equal; #added
	ignore sub equal' equal' greater; #escape equal_equal_greater
	ignore sub equal' equal' less; #escape equal_equal_less
	ignore sub equal equal' equal;
	ignore sub equal' equal equal;
	sub liga.spacer equal' by equal_equal.liga;
	sub equal' equal by liga.spacer;
} equal_equal_liga;

lookup equal_equal_equal_liga {
	ignore sub equal' equal' equal' less; #equal_greater escape
	ignore sub equal' equal' equal' greater; #equal_greater escape
	ignore sub slash equal' equal equal; #equal_greater escape
	ignore sub less equal' equal equal; #equal_greater escape
	ignore sub greater equal' equal equal; #equal_greater escape
	ignore sub exclam equal' equal equal; #added
	ignore sub equal equal equal' equal;
	ignore sub equal equal' equal equal;
	ignore sub equal' equal equal equal;
	sub liga.spacer liga.spacer equal' by equal_equal_equal.liga;
	sub liga.spacer equal' equal by liga.spacer;
	sub equal' equal equal by liga.spacer;
} equal_equal_equal_liga;

lookup period_period_liga {
	ignore sub period period' period;
	ignore sub period' period period;
	sub liga.spacer period' by period_period.liga;
	sub period' period by liga.spacer;
} period_period_liga;

lookup period_period_period_liga {
	ignore sub period period period' period;
	ignore sub period period' period period;
	ignore sub period' period period period;
	sub liga.spacer liga.spacer period' by period_period_period.liga;
	sub liga.spacer period' period by liga.spacer;
	sub period' period period by liga.spacer;
} period_period_period_liga;

lookup exclam_equal_liga {
	ignore sub period exclam' equal; #exclam_equal_equal escape
	ignore sub exclam' equal' equal; #exclam_equal_equal escape
	ignore sub exclam' exclam' exclam;
	sub liga.spacer equal' by exclam_equal.liga;
	sub exclam' equal by liga.spacer;
} exclam_equal_liga;

lookup exclam_equal_equal_liga {
	ignore sub period exclam' equal' equal; #exclam_equal_equal escape
	ignore sub exclam' equal' equal' equal; #exclam_equal_equal escape
	sub liga.spacer liga.spacer equal' by exclam_equal_equal.liga;
	sub liga.spacer equal' equal by liga.spacer;
	sub exclam' equal equal by liga.spacer;
} exclam_equal_equal_liga;

lookup equal_greater_liga {
	ignore sub greater' equal' greater; #equal_greater_equal escape
	ignore sub equal equal' greater; #equal_greater_equal escape
	ignore sub equal' greater' equal; #equal_greater_equal escape
	ignore sub equal' equal' equal greater; #exclam_equal_equal escape
	ignore sub equal' equal' greater;
	sub liga.spacer greater' by equal_greater.liga;
	sub equal' greater by liga.spacer;
} equal_greater_liga;

lookup hyphen_greater_liga {
	ignore sub hyphen' hyphen' hyphen greater; #exclam_hyphen_hyphen escape
	ignore sub hyphen' hyphen' greater;
	sub liga.spacer greater' by hyphen_greater.liga;
	sub hyphen' greater by liga.spacer;
} hyphen_greater_liga;

lookup less_hyphen_liga {
	ignore sub less' less' less hyphen; #exclam_less_less escape
	ignore sub less' less' hyphen;
	sub liga.spacer hyphen' by less_hyphen.liga;
	sub less' hyphen by liga.spacer;
} less_hyphen_liga;

lookup less_equal_liga {
	ignore sub less' equal' equal; #exclam_less_less escape
	ignore sub equal' less' equal; #exclam_less_less escape
	ignore sub less' less' less equal; #exclam_less_less escape
	ignore sub less' less' equal;
	ignore sub quotedbl' less' equal;
	ignore sub quotesingle' less' equal;
	sub liga.spacer equal' by less_equal.liga;
	sub less' equal by liga.spacer;
} less_equal_liga;

lookup greater_equal_liga {
	ignore sub greater' equal' equal; #exclam_greater_greater escape
	ignore sub equal' greater' equal; #exclam_greater_greater escape
	ignore sub greater' greater' greater equal; #exclam_greater_greater escape
	ignore sub quotedbl' greater' equal;
	ignore sub quotesingle' greater' equal;
	ignore sub greater' greater' equal;
	sub liga.spacer equal' by greater_equal.liga;
	sub greater' equal by liga.spacer;
} greater_equal_liga;


lookup question_period_liga {
	ignore sub question' question' question period; #exclam_question_question escape
	ignore sub question' question' period;
	sub liga.spacer period' by question_period.liga;
	sub question' period by liga.spacer;
} question_period_liga;

lookup equal_greater_equal_liga {
	ignore sub equal' equal' greater' equal; #equal_equal_equal escape
	ignore sub equal' greater' equal' equal; #equal_equal_equal escape
	sub liga.spacer liga.spacer equal' by equal_greater_equal.liga;
	sub liga.spacer greater' equal by liga.spacer;
	sub equal' greater equal by liga.spacer;
} equal_greater_equal_liga;

lookup equal_less_equal_liga {
	ignore sub equal' equal' less' equal; #equal_equal_equal escape
	ignore sub equal' less' equal' equal; #equal_equal_equal escape
	sub liga.spacer liga.spacer equal' by equal_less_equal.liga;
	sub liga.spacer less' equal by liga.spacer;
	sub equal' less equal by liga.spacer;
} equal_less_equal_liga;

lookup equal_less_less_liga {
	ignore sub equal' equal' less' less; #equal_less_less escape
	ignore sub equal' less' less' less; #equal_less_less escape
	sub liga.spacer liga.spacer less' by equal_less_less.liga;
	sub liga.spacer less' less by liga.spacer;
	sub equal' less less by liga.spacer;
} equal_less_less_liga;

lookup greater_greater_equal_liga {
	ignore sub @NON_SPACING' greater' greater' equal; #greater_greater_equal_liga escape
	ignore sub greater' greater' greater' equal; #greater_greater_equal_liga escape
	ignore sub greater' greater' equal' @NON_SPACING; #greater_greater_equal_liga escape
	sub liga.spacer liga.spacer equal' by greater_greater_equal.liga;
	sub liga.spacer greater' equal by liga.spacer;
	sub greater' greater equal by liga.spacer;
} greater_greater_equal_liga;

lookup ampersand_ampersand_liga {
	ignore sub ampersand ampersand' ampersand;
	ignore sub ampersand' ampersand ampersand;
	sub liga.spacer ampersand' by ampersand_ampersand.liga;
	sub ampersand' ampersand by liga.spacer;
} ampersand_ampersand_liga;

lookup less_dollar_greater_liga {
	ignore sub @NON_SPACING' less' dollar' greater; #greater_greater_greater escape
	ignore sub less' dollar' greater' @NON_SPACING; #greater_greater_greater escape
	sub liga.spacer liga.spacer greater' by less_dollar_greater.liga;
	sub liga.spacer dollar' greater by liga.spacer;
	sub less' dollar greater by liga.spacer;
} less_dollar_greater_liga;

lookup less_dollar_liga {
